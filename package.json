{
  "name": "devops-assessment-api",
  "version": "1.0.0",
  "description": "TypeScript Node.js API (Express + routing-controllers + TypeDI) exposing /health, /ready and /getAccount, with Prometheus metrics on a separate port",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^4.22.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
