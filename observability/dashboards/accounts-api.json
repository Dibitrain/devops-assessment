      }
    },
    {
      "type": "timeseries",
      "title": "Resident memory per pod",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (process_resident_memory_bytes{namespace=\"$namespace\", job=\"$job\"})",
